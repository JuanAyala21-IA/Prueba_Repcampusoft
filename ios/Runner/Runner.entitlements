<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Habilita las notificaciones push (APNs) para la app.
	     Para distribuir en App Store, el perfil de aprovisionamiento cambia
	     este valor a `production` automáticamente. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
